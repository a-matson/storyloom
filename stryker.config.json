{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "tsconfigFile": "tsconfig.stryker-none.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["src/core/**/*.ts", "!src/core/**/index.ts", "!src/core/**/types.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "docs/measurements/mutation.json" },
  "ignorePatterns": ["dist", "dist-measure", "docs", "playwright-report", "test-results"],
  "thresholds": { "high": 80, "low": 60, "break": null }
}
