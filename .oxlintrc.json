{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-await-in-loop": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableString": true,
        "allowNullableBoolean": true
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 250,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@adapters/*", "@app/*", "@ui/*", "react", "react-dom", "react/*", "react-dom/*"],
                "message": "core is pure TypeScript: it depends on nothing above it (ports live in core/ports)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/adapters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@app/*", "@ui/*", "react", "react-dom"],
                "message": "adapters implement core ports; they never import app or ui."
              },
              {
                "group": ["@core/*/*", "@adapters/*/*"],
                "message": "Import a module through its index (e.g. '@core/model'), not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@ui/*"],
                "message": "app composes core and adapters; ui depends on app, not the reverse."
              },
              {
                "group": ["@core/*/*", "@adapters/*/*"],
                "message": "Import a module through its index (e.g. '@core/model'), not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@adapters/*"],
                "message": "ui reaches adapters only through app."
              },
              {
                "group": ["@core/*/*", "@adapters/*/*"],
                "message": "Import a module through its index (e.g. '@core/model'), not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/**", "e2e/**", "bench/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "max-lines-per-function": "off",
        "unicorn/consistent-function-scoping": "off",
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": [
        "src/ui/**",
        "src/app/**",
        "src/core/ports/provider.ts",
        "src/adapters/storage/**",
        "src/adapters/providers/http.ts",
        "src/adapters/providers/llamaServer.ts",
        "src/adapters/providers/openaiCompat.ts",
        "src/core/cards/cardGenerator.ts",
        "src/adapters/embeddings/embeddings.worker.ts"
      ],
      "rules": {
        "typescript/strict-boolean-expressions": [
          "warn",
          {
            "allowNullableString": true,
            "allowNullableBoolean": true
          }
        ],
        "typescript/no-non-null-assertion": "warn",
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-misused-promises": "warn",
        "typescript/no-unnecessary-type-assertion": "warn",
        "typescript/no-unnecessary-type-conversion": "warn",
        "typescript/consistent-type-imports": "warn",
        "max-lines": "warn",
        "max-lines-per-function": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/control-has-associated-label": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/no-noninteractive-element-interactions": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn",
        "react/refs": "warn",
        "react/exhaustive-effect-dependencies": "warn",
        "react/memo-dependencies": "warn",
        "react/set-state-in-effect": "warn",
        "react/no-array-index-key": "warn",
        "unicorn/prefer-add-event-listener": "warn",
        "unicorn/require-post-message-target-origin": "warn",
        "unicorn/no-array-sort": "warn",
        "unicorn/consistent-function-scoping": "warn",
        "promise/always-return": "warn",
        "typescript/consistent-return": "warn"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**", "playwright-report/**", "test-results/**", "bench/results/**"]
}
